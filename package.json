{
  "name": "@github2hu/dsh-ssh-workspace",
  "version": "0.3.5",
  "description": "Remote SSH workspaces for DSH: mount a directory on an SSH host as a DSH workspace with browser UI sidebar panel, plus remote-workspace skills and run_code support",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/github2hu/dsh-ssh-workspace.git"
  },
  "homepage": "https://github.com/github2hu/dsh-ssh-workspace#readme",
  "bugs": {
    "url": "https://github.com/github2hu/dsh-ssh-workspace/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./protocol": {
      "default": "./lib/protocol.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "ssh",
    "workspace",
    "remote"
  ],
  "author": "siqyka",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "contributors": [
    "github2hu"
  ]
}
